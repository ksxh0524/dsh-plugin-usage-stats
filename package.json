{
  "name": "dsh-plugin-usage-stats",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH (DeepSeek Harness) Web GUI plugin: global model token usage stats — input/output/cache read/cache write, cache hit rate, per-model/per-day/per-session breakdown, optional cost via a configurable price table. Right-sidebar usage tab.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "usage",
    "statistics",
    "tokens",
    "cache-hit-rate"
  ],
  "license": "MIT",
  "author": "ksxh0524",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksxh0524/dsh-plugins.git",
    "directory": "plugin-usage-stats"
  },
  "main": "src/cordis.ts",
  "exports": {
    ".": "./src/cordis.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "tests",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts"
  }
}
